{
  "schemaVersion": 1,
  "dependencies": {
    "provider": "dependabot",
    "dependabotAlerts": true,
    "dependabotSecurityUpdates": true,
    "renovate": null,
    "dependabot": {
      "cooldown": {
        "routineDays": 14,
        "securityDays": 1
      },
      "schedule": {
        "interval": "weekly",
        "day": "monday",
        "time": "06:00",
        "timezone": "America/Los_Angeles"
      },
      "labels": ["dependencies"],
      "groups": {
        "github-actions": {
          "patterns": ["*"],
          "update-types": ["major", "minor", "patch"]
        },
        "minor-patch": {
          "patterns": ["*"],
          "update-types": ["minor", "patch"]
        }
      }
    }
  }
}
